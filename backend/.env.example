# FranchiseIQ Environment Configuration Template
# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/franchiseiq?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=franchiseiq

# Security & Authentication
SECRET_KEY=franchiseiq-super-secure-jwt-secret-key-2026-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Legacy SQL DB (Fallback / Migration source)
DATABASE_URL=sqlite:///./franchiseiq.db

# Ingestion Scheduler
DATA_REFRESH_INTERVAL_HOURS=24
